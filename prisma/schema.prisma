// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  employeeId  String?
  googleId    String?
  isActive    Boolean  @default(true)
  joinedDate  DateTime
  updatedAt   DateTime @updatedAt
  phoneNumber String?
  roleId      String?
  avatar      String?
  stationCode String?
  tasks       Task[]
}

model Task {
  id               String   @id @default(uuid())
  userId           String
  taskTitle        String
  difficulty       String
  correctness      Int
  timeTakenSeconds Int
  maxTimeSeconds   Int
  completedAt      DateTime
  user             User     @relation(fields: [userId], references: [id])
}
