# Data store (tables: users, roster, work_tasks, settings, …)
DATA_STORE_ID=
# Path to the credentials JSON file (relative to the project root, or absolute)
DATA_STORE_KEY_PATH=./keys/credentials.json

# Alternative to DATA_STORE_KEY_PATH (hosts without a file system, e.g. Netlify): set both of these instead
# DATA_STORE_CLIENT_EMAIL=service-account@example.iam.example.com
# DATA_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Sign-in with Google (required in production; the app fails closed with a 503 without it) ---
# Everything except /login needs a Google sign-in by someone with an ACTIVE row in the `users` tab (matched by email).
# 1. Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# 2. Authorized redirect URI: ${APP_URL}/api/auth/google/callback (add one per origin you sign in from).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the site, no trailing slash (also used when the host reports an internal URL)
APP_URL=http://localhost:3000
# Signs the session / OAuth cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=at-least-16-random-characters
# WhatsApp number (digits, country code, no +) shown in the "not registered" banner
CONTACT_WHATSAPP=60123456789
# Optional: only accept this Google Workspace domain (extra guard on top of the users tab)
# GOOGLE_ALLOWED_DOMAIN=airasia.com
# Escape hatch for a private network / SSO-protected deploy ONLY. Leave unset otherwise.
# AUTH_DISABLED=true
