# Data store (tables: users, roster, work_tasks, settings, …)
DATA_STORE_ID=
# Path to the credentials JSON file (relative to the project root, or absolute)
DATA_STORE_KEY_PATH=./keys/credentials.json

# Alternative to DATA_STORE_KEY_PATH (hosts without a file system, e.g. Netlify): set both of these instead
# DATA_STORE_CLIENT_EMAIL=service-account@example.iam.example.com
# DATA_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
