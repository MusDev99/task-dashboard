# Google Sheet used as the database (tabs: "users", "tasks")
GOOGLE_SHEET_ID=
# Path to the service-account JSON key file (relative to the project root, or absolute)
GOOGLE_SHEET_PATH=./google-service-account.json

# Alternative to GOOGLE_SHEET_PATH (e.g. Netlify): set both of these instead
GOOGLE_SERVICE_ACCOUNT_EMAIL=google-sheet-sync@mus-project-2024.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Sign-in (required in production; the app fails closed with a 503 without it) ---
# Everything except /login needs the team password. Generate the secret with: openssl rand -base64 32
ADMIN_PASSWORD=choose-a-long-passphrase
AUTH_SECRET=at-least-16-random-characters
# Escape hatch for a private network / SSO-protected deploy ONLY. Leave unset otherwise.
# AUTH_DISABLED=true
